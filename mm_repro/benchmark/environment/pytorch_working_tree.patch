+            if isinstance(other, float) and not math.isfinite(other)
+            else repr(other)
+        )
+        fallback = self.emit(
+            f"torch.full_like({result.name}, {literal})", result.depending_indices
+        )
+        return self._default("where", (mask, result, fallback), {})
